# Copy to .env. Never commit this file after adding secrets.
ZELDA_DATA_DIR=.local
ZELDA_BRIDGE_PORT=8766
# Generate a random token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZELDA_BRIDGE_TOKEN=
# Optional; otherwise enter the OpenRouter key in the local panel for this process only.
OPENROUTER_API_KEY=
# Native codex executable on PATH; use an absolute path if necessary.
ZELDA_CODEX_COMMAND=codex
# The application uses an isolated Codex home and the official ChatGPT login flow.
# No auth.json is read or copied by Zelda AI Player.
